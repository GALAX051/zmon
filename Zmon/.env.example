# Endereço da controladora UniFi (sem protocolo), ex: 192.168.1.1 ou unifi.minhaempresa.com
UNIFI_HOST=192.168.1.1

# Porta da API. Controladora clássica (CloudKey/software): 8443. UniFi OS (UDM/UDM Pro/UDM SE): 443
UNIFI_PORT=8443

# true se for UDM/UDM Pro/UDM SE/Cloud Gateway (UniFi OS). false para controladora clássica standalone.
UNIFI_IS_UDM=false

# API Token (gerado em Settings > Administrators > Create API Token na UniFi)
# Se preenchido, usa token. Senão, tenta login com username/password abaixo.
UNIFI_API_TOKEN=

# Username e password (usados só se UNIFI_API_TOKEN estiver vazio)
UNIFI_USERNAME=admin
UNIFI_PASSWORD=changeme

# Nome do site na controladora (aparece na URL do painel web da UniFi). "default" na maioria dos casos.
UNIFI_SITE=default

# Ignorar certificado autoassinado da controladora (comum em instalações locais)
UNIFI_ALLOW_SELF_SIGNED=true

# Porta em que o ZMon vai rodar
PORT=3000

# Intervalo de atualização automática no frontend (ms). Baixamos pra 5s pra ficar
# o mais próximo possível de tempo real via polling REST — a UniFi só atualiza os
# contadores de tráfego quando o AP reporta pra controladora (tipicamente 20-40s),
# então valores abaixo disso não trazem dado mais novo, só reduzem a espera até
# capturar o próximo dado que chegar.
REFRESH_INTERVAL_MS=5000
